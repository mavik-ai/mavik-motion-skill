{
  "name": "mavik-motion-skill",
  "version": "1.2.0",
  "description": "Skill open source de direção, contexto de marca, Remotion/GSAP/Three.js, áudio, beat sync e QA para Codex e Claude Code.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "doctor:json": "node scripts/doctor.mjs --json",
    "storyboard:check": "node scripts/validate-shotlist.mjs examples/ia10x/shotlist.json",
    "demo:plan": "node scripts/validate-shotlist.mjs examples/demo-hyperframes/shotlist.json",
    "test": "node --test tests/*.test.mjs",
    "demo:lint": "npx --no-install hyperframes lint examples/demo-hyperframes",
    "demo:check": "npx --no-install hyperframes check examples/demo-hyperframes",
    "demo:render": "npx --no-install hyperframes render examples/demo-hyperframes --output examples/demo-hyperframes/out/demo.mp4",
    "release:check": "node scripts/release-check.mjs",
    "brief:check": "node scripts/brief-check.mjs examples/ia10x/brief.json",
    "brief:template": "node scripts/brief-check.mjs --template",
    "demo:remotion:install": "npm --prefix examples/demo-remotion install",
    "demo:remotion:render": "npm --prefix examples/demo-remotion run render",
    "demo:remotion:still": "npm --prefix examples/demo-remotion run still"
  }
}
